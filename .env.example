# Copy locally, fill unique secrets; never commit .env. Do not use these placeholders as credentials.
DATABASE_URL=postgresql://qb_app:REPLACE_WITH_HEX_APP_PASSWORD@127.0.0.1:5432/qingbao_dev
MIGRATION_DATABASE_URL=postgresql://qb_owner:REPLACE_OWNER_PASSWORD@127.0.0.1:5432/qingbao_dev
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=http://127.0.0.1:8780
HOST=127.0.0.1
PORT=8780
FILE_STORAGE_DIR=.data/files
# Compose uses an actual domain and unique secrets, never a default password:
DOMAIN=your-real-domain.example
DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Set only while bootstrapping an empty user database, then remove:
# BOOTSTRAP_USERNAME=youradmin
# BOOTSTRAP_PASSWORD=UNIQUE_INITIAL_PASSWORD_AT_LEAST_12_CHARACTERS

# Required for v1.1 employee bank accounts: independent random 32-byte key as 64 hex characters.
# Keep offline/encrypted backup of this key separately; losing it makes stored account numbers unreadable.
ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX_KEY
